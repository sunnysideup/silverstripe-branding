{
  "name": "sunnysideup/branding",
  "description": "Use only for SSU",
  "type": "silverstripe-vendormodule",
  "keywords": [
    "branding",
    "private",
    "not cool"
  ],
  "license": "BSD-3-Clause",
  "require": {
    "silverstripe/admin": "^3.0"
  },
  "require-dev": {
    "sunnysideup/sswebpack_engine_only": "dev-main",
    "silverleague/ideannotator": "*",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.7",
    "silverstripe/standards": "^1",
    "phpstan/extension-installer": "^1.3"
  },
  "autoload": {
    "psr-4": {
      "Sunnysideup\\Branding\\": "src/"
    }
  },
  "extra": {
    "expose": [
      "client/dist"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "authors": [
    {
      "name": "Nicolaas Thiemen Francken",
      "email": "modules@sunnysideup.co.nz",
      "role": "lead developer"
    }
  ]
}
